# Copy to .env.local (git-ignored) and fill in to build with Google sign-in / account sync (docs/supabase-sync.md).
# Both values are public by design (row level security protects the data), but they stay out of the repository.
# Leave them empty and the app has no "Tài khoản" card: everything else works as before.

# The daily-english main project: Supabase dashboard → Project Settings → API (or daily-english/src/environments/environment.ts).
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_…). NEVER a secret / service_role key: the build refuses sb_secret_ keys.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: where the portable file sends its sign-in (default https://hnp180493.github.io/english-listening/).
VITE_WEB_APP_URL=
